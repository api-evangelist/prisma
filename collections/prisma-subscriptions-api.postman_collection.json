          "name": "Prisma Create a transient event subscription",
          "request": {
            "name": "Prisma Create a transient event subscription",
            "description": {
              "content": "Creates a transient subscription to database change events for a specific model. The subscribe() method provides at-most-once delivery with no ordering guarantees. Events that occur while the subscriber is disconnected are not recovered. For guaranteed delivery, use the stream() API instead.",
              "type": "text/plain"
            },

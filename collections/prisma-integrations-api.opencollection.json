{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prisma Accelerate Aggregation Integrations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Prisma List configured integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accelerate.prisma-data.net/integrations"
          },
          "docs": "Retrieves all third-party integrations configured for the current workspace or project."
        }
      ]
    }
  ],
  "bundled": true
}
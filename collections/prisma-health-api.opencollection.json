{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prisma Accelerate Aggregation Health API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Prisma Check Accelerate service health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accelerate.prisma-data.net/health"
          },
          "docs": "Returns the current health status of the Accelerate proxy service including regional availability information."
        }
      ]
    }
  ],
  "bundled": true
}
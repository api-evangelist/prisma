          "name": "Prisma Invalidate cache entries by tags",
          "request": {
            "name": "Prisma Invalidate cache entries by tags",
            "description": {
              "content": "Invalidates cached query results that were tagged with the specified cache tags. Up to 5 tags can be specified per request. Tags are alphanumeric strings with underscores, maximum 64 characters each. This endpoint is available on paid plans only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "invalidate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },

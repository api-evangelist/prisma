                  "disabled": false,
                  "key": "severity",
                  "value": "<string>",
                  "description": "Filter recommendations by severity level"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "sessionId",
                  "description": "(Required) Unique identifier of the recording session"
                }

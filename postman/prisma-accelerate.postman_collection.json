                      "raw": "{\n  \"query\": \"<string>\",\n  \"variables\": {\n    \"id0\": true,\n    \"esse_a4\": \"sit qui quis\"\n  },\n  \"extensions\": {\n    \"cacheStrategy\": {\n      \"ttl\": \"<integer>\",\n      \"swr\": \"<integer>\",\n      \"tags\": [\n        \"9UVSKNpPH8Z7B21Nogv8rFeJFEBkUpk\",\n        \"Dmj_89QGO4emaTORn3p1\"\n      ]\n    }\n  }\n}",

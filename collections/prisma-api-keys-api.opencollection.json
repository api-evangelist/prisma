{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prisma Accelerate Aggregation API Keys API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Prisma List API keys for an environment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accelerate.prisma-data.net/environments/:environmentId/apikeys",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the environment"
              }
            ]
          },
          "docs": "Retrieves all API keys associated with a specific environment. API keys are used to authenticate Prisma Client requests to platform resources."
        },
        {
          "info": {
            "name": "Prisma Create an API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://accelerate.prisma-data.net/environments/:environmentId/apikeys",
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the environment"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a new API key for the specified environment. The full API key value is only returned once during creation and cannot be retrieved later."
        },
        {
          "info": {
            "name": "Prisma Delete an API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://accelerate.prisma-data.net/apikeys/:apiKeyId",
            "params": [
              {
                "name": "apiKeyId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the API key"
              }
            ]
          },
          "docs": "Permanently revokes and deletes an API key. Any clients using this key will immediately lose access."
        }
      ]
    }
  ],
  "bundled": true
}
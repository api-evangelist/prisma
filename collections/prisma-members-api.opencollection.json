{
  "opencollection": "1.0.0",
  "info": {
    "name": "Prisma Accelerate Aggregation Members API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Prisma List workspace members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://accelerate.prisma-data.net/workspaces/:workspaceId/members",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the workspace"
              }
            ]
          },
          "docs": "Retrieves all members of a workspace including their roles and invitation status."
        }
      ]
    }
  ],
  "bundled": true
}
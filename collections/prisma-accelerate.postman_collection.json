      "item": [
        {
          "id": "e07380d7-c7cb-4e08-a951-4f14b9ccc309",
          "name": "Prisma Execute a proxied database query",
          "request": {
            "name": "Prisma Execute a proxied database query",
            "description": {
              "content": "Executes a Prisma Client query through the Accelerate proxy. The proxy manages connection pooling, applies caching strategies based on the cacheStrategy parameters, and returns results from cache when available. Cache behavior is controlled by TTL (time-to-live) and SWR (stale-while-revalidate) headers or query parameters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":apiVersion",
                ":engineHash",
                "graphql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "apiVersion",
                  "description": "(Required) Prisma engine API version"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "engineHash",
                  "description": "(Required) Prisma engine version hash for protocol compatibility"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"<string>\",\n  \"variables\": {\n    \"key_0\": false\n  },\n  \"extensions\": {\n    \"cacheStrategy\": {\n      \"ttl\": \"<integer>\",\n      \"swr\": \"<integer>\",\n      \"tags\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }

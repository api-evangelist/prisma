      "description": {
        "content": "Resumable event streams with at-least-once delivery and ordering guarantees. Requires event persistence to be enabled.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cf5995ef-0460-434c-8d2b-8609c1d9f948",
          "name": "Prisma Create a named event stream",
          "request": {
            "name": "Prisma Create a named event stream",
            "description": {
              "content": "Creates a new named event stream for a specific database model. Named streams are resumable, meaning that if the consumer disconnects and reconnects with the same stream name, it will resume from where it left off. Requires event persistence to be enabled on the environment. The stream() API provides at-least-once delivery with correct ordering guarantees.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "streams"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
